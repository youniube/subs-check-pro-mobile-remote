-// ClearCache 检测结束后释放包级全局状态
-func ClearCache() {
-	uniqueSubsCount = 0
-	totalRawHits.Store(0)
-	SubStats = make(map[string]SubStat)
+func ensureSubStatsEntries(subURLs []string) {
+	for _, subURL := range subURLs {
+		if _, exists := SubStats[subURL]; !exists {
+			SubStats[subURL] = SubStat{}
+		}
+	}
+}
 
-	// 关闭所有复用 client 的连接池，释放 TLS session cache 和 idle conn
+// ClearFetchCache 释放订阅拉取使用的连接池，但保留生成分析报告仍需使用的
+// 逐订阅统计。
+func ClearFetchCache() {
 	clientMapCache.Range(func(key, value any) bool {
 		if c, ok := value.(*http.Client); ok {
 			c.CloseIdleConnections()
 		}
 		clientMapCache.Delete(key)
 		return true
 	})
 }
+
+// ClearCache 检测结束后释放包级全局状态
+func ClearCache() {
+	uniqueSubsCount = 0
+	totalRawHits.Store(0)
+	SubStats = make(map[string]SubStat)
+	ClearFetchCache()
+}
diff --git a/proxy/proxies_test.go b/proxy/proxies_test.go
new file mode 100644
index 0000000..2b99f79
--- /dev/null
+++ b/proxy/proxies_test.go
@@ -0,0 +1,43 @@
+package proxies
+
+import "testing"
+
+func TestEnsureSubStatsEntriesPreservesActiveAndAddsSilent(t *testing.T) {
+	original := SubStats
+	t.Cleanup(func() { SubStats = original })
+
+	SubStats = map[string]SubStat{
+		"https://active.example/sub": {Total: 12, Success: 3},
+	}
+	ensureSubStatsEntries([]string{
+		"https://active.example/sub",
+		"https://silent.example/sub",
+	})
+
+	active := SubStats["https://active.example/sub"]
+	if active.Total != 12 || active.Success != 3 {
+		t.Fatalf("active stats changed: %+v", active)
+	}
+	silent, exists := SubStats["https://silent.example/sub"]
+	if !exists {
+		t.Fatal("silent subscription was not added")
+	}
+	if silent.Total != 0 || silent.Success != 0 {
+		t.Fatalf("silent stats are not zero: %+v", silent)
+	}
+}
+
+func TestClearFetchCachePreservesSubscriptionStats(t *testing.T) {
+	original := SubStats
+	t.Cleanup(func() { SubStats = original })
+
+	SubStats = map[string]SubStat{
+		"https://active.example/sub": {Total: 8, Success: 2},
+	}
+	ClearFetchCache()
+
+	got := SubStats["https://active.example/sub"]
+	if got.Total != 8 || got.Success != 2 {
+		t.Fatalf("fetch cache cleanup changed subscription stats: %+v", got)
+	}
+}
