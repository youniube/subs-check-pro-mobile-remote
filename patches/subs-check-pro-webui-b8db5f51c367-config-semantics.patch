@@ -0,0 +1,25 @@
+package webui
+
+import (
+	"regexp"
+	"testing"
+)
+
+func TestConfigFormHasOneControlPerField(t *testing.T) {
+	source, err := StaticFS.ReadFile("static/js/config-form.js")
+	if err != nil {
+		t.Fatal(err)
+	}
+	matches := regexp.MustCompile(`key:\s*'([^']+)'`).FindAllSubmatch(source, -1)
+	if len(matches) != 89 {
+		t.Fatalf("config form control count = %d, want 89", len(matches))
+	}
+	seen := make(map[string]struct{}, len(matches))
+	for _, match := range matches {
+		key := string(match[1])
+		if _, exists := seen[key]; exists {
+			t.Fatalf("config form field %q has multiple controls", key)
+		}
+		seen[key] = struct{}{}
+	}
+}
