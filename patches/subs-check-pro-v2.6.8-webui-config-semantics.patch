+package app
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+func TestAPIKeyTransitionKeepsPreviousKeyDuringGracePeriod(t *testing.T) {
+	original := *config.GlobalConfig
+	defer func() { *config.GlobalConfig = original }()
+
+	app := &App{}
+	config.GlobalConfig.APIKey = "new-key"
+	app.recordAPIKeyTransition("old-key", "new-key")
+
+	if !app.authenticateAPIKey("new-key") {
+		t.Fatal("new API key was rejected")
+	}
+	if !app.authenticateAPIKey("old-key") {
+		t.Fatal("previous API key was rejected during grace period")
+	}
+	app.authMu.Lock()
+	app.previousAPIKeyExpires = time.Now().Add(-time.Second)
+	app.authMu.Unlock()
+	if app.authenticateAPIKey("old-key") {
+		t.Fatal("expired previous API key was accepted")
+	}
+}
+
+func TestPendingAPIKeyChangesOnlyAfterCurrentCheck(t *testing.T) {
+	const oldConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+api-key: "old-key"
+sub-store-port: ""
+`
+	const newConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+api-key: "new-key"
+sub-store-port: ""
+`
+	app := newRuntimeConfigTestApp(t, oldConfig)
+	if !app.beginCheck() {
+		t.Fatal("check did not start")
+	}
+	writeRuntimeConfig(t, app.configPath, newConfig)
+	if _, err := app.onConfigChange(); err != nil {
+		t.Fatal(err)
+	}
+	if !app.authenticateAPIKey("old-key") || app.authenticateAPIKey("new-key") {
+		t.Fatal("API key changed before the current check finished")
+	}
+
+	app.finishCheck()
+	if !app.authenticateAPIKey("new-key") {
+		t.Fatal("new API key was not applied after the current check")
+	}
+	if !app.authenticateAPIKey("old-key") {
+		t.Fatal("old API key was not retained for transition grace")
+	}
+}
