--- /dev/null
+++ b/app/config_policy.go
@@ -0,0 +1,78 @@
+package app
+
+import (
+	"reflect"
+	"sort"
+	"strings"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+const (
+	configEffectNextCheck            = "next-check"
+	configEffectRequestBoundary      = "request-boundary"
+	configEffectSchedulerReconfigure = "scheduler-reconfigure"
+	configEffectServiceReconfigure   = "service-reconfigure"
+	configEffectNextStartup          = "next-startup"
+	configEffectRestartRequired      = "restart-required"
+)
+
+type configFieldPolicy struct {
+	Path              string `json:"path"`
+	Effect            string `json:"effect"`
+	DuringActiveCheck string `json:"during_active_check"`
+}
+
+var configEffectOverrides = map[string]string{
+	"api-key":                configEffectRequestBoundary,
+	"share-password":         configEffectRequestBoundary,
+	"enable-web-ui":          configEffectRequestBoundary,
+	"cron-expression":        configEffectSchedulerReconfigure,
+	"check-interval":         configEffectSchedulerReconfigure,
+	"update":                 configEffectSchedulerReconfigure,
+	"cron-check-update":      configEffectSchedulerReconfigure,
+	"sub-store-port":         configEffectServiceReconfigure,
+	"sub-store-path":         configEffectServiceReconfigure,
+	"sub-store-sync-cron":    configEffectServiceReconfigure,
+	"sub-store-produce-cron": configEffectServiceReconfigure,
+	"sub-store-push-service": configEffectServiceReconfigure,
+	"mihomo-overwrite-url":   configEffectServiceReconfigure,
+	"output-dir":             configEffectServiceReconfigure,
+	"update-on-startup":      configEffectNextStartup,
+	"listen-port":            configEffectRestartRequired,
+}
+
+func configFieldPolicies() []configFieldPolicy {
+	policies := make([]configFieldPolicy, 0, 96)
+	collectConfigFieldPolicies(reflect.TypeOf(config.Config{}), "", &policies)
+	sort.Slice(policies, func(i, j int) bool {
+		return policies[i].Path < policies[j].Path
+	})
+	return policies
+}
+
+func collectConfigFieldPolicies(configType reflect.Type, prefix string, policies *[]configFieldPolicy) {
+	for index := 0; index < configType.NumField(); index++ {
+		field := configType.Field(index)
+		yamlName := strings.Split(field.Tag.Get("yaml"), ",")[0]
+		if yamlName == "" || yamlName == "-" {
+			continue
+		}
+		path := yamlName
+		if prefix != "" {
+			path = prefix + "." + yamlName
+		}
+		effect := configEffectOverrides[path]
+		if effect == "" {
+			effect = configEffectNextCheck
+		}
+		*policies = append(*policies, configFieldPolicy{
+			Path:              path,
+			Effect:            effect,
+			DuringActiveCheck: "after-current-check",
+		})
+		if field.Type.Kind() == reflect.Struct {
+			collectConfigFieldPolicies(field.Type, path, policies)
+		}
+	}
+}
