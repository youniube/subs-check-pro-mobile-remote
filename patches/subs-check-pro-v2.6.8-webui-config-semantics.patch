@@ -0,0 +1,49 @@
+package app
+
+import (
+	"crypto/subtle"
+	"time"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+const apiKeyGracePeriod = 5 * time.Minute
+
+type authKeyTransition struct {
+	Changed        bool   `json:"changed"`
+	State          string `json:"state"`
+	DesiredVersion uint64 `json:"desired_version"`
+	AppliedVersion uint64 `json:"applied_version"`
+}
+
+func constantTimeKeyEqual(candidate, expected string) bool {
+	if candidate == "" || expected == "" {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(candidate), []byte(expected)) == 1
+}
+
+func (app *App) recordAPIKeyTransition(previous, current string) {
+	if previous == "" || previous == current {
+		return
+	}
+	app.authMu.Lock()
+	app.previousAPIKey = previous
+	app.previousAPIKeyExpires = time.Now().Add(apiKeyGracePeriod)
+	app.authMu.Unlock()
+}
+
+func (app *App) authenticateAPIKey(candidate string) bool {
+	app.configReloadMu.Lock()
+	current := config.GlobalConfig.APIKey
+	app.configReloadMu.Unlock()
+	if constantTimeKeyEqual(candidate, current) {
+		return true
+	}
+
+	app.authMu.RLock()
+	previous := app.previousAPIKey
+	expires := app.previousAPIKeyExpires
+	app.authMu.RUnlock()
+	return time.Now().Before(expires) && constantTimeKeyEqual(candidate, previous)
+}
