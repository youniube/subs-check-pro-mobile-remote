--- /dev/null
+++ b/app/webui_runtime_test.go
@@ -0,0 +1,38 @@
+package app
+
+import (
+	"html/template"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+func TestWebUIAccessFollowsAppliedConfigWithoutRouterRestart(t *testing.T) {
+	original := *config.GlobalConfig
+	defer func() { *config.GlobalConfig = original }()
+
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.SetHTMLTemplate(template.Must(template.New("admin.html").Parse(`{{define "admin.html"}}admin{{end}}`)))
+	app := &App{configPath: "config.yaml"}
+	app.registerWebUIRoutes(router)
+
+	request := func() *httptest.ResponseRecorder {
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, AdminPath, nil))
+		return response
+	}
+
+	config.GlobalConfig.EnableWebUI = false
+	if response := request(); response.Code != http.StatusForbidden {
+		t.Fatalf("disabled WebUI status = %d, want 403", response.Code)
+	}
+	config.GlobalConfig.EnableWebUI = true
+	response := request()
+	if response.Code != http.StatusOK || response.Body.String() != "admin" {
+		t.Fatalf("enabled WebUI response = (%d, %q)", response.Code, response.Body.String())
+	}
+}
