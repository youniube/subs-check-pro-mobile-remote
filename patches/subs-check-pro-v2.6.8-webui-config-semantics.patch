+package app
+
+import "testing"
+
+func TestAllConfigFieldsHaveOneRuntimePolicy(t *testing.T) {
+	policies := configFieldPolicies()
+	if len(policies) != 96 {
+		t.Fatalf("runtime policy field count = %d, want 96", len(policies))
+	}
+	seen := make(map[string]configFieldPolicy, len(policies))
+	for _, policy := range policies {
+		if policy.Path == "" || policy.Effect == "" || policy.DuringActiveCheck == "" {
+			t.Fatalf("incomplete policy: %#v", policy)
+		}
+		if _, exists := seen[policy.Path]; exists {
+			t.Fatalf("duplicate policy for %q", policy.Path)
+		}
+		seen[policy.Path] = policy
+	}
+	for path, effect := range configEffectOverrides {
+		policy, exists := seen[path]
+		if !exists {
+			t.Fatalf("override references unknown config field %q", path)
+		}
+		if policy.Effect != effect {
+			t.Fatalf("policy for %q = %q, want %q", path, policy.Effect, effect)
+		}
+	}
+}
