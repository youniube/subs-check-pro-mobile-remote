+type silentSubscriptionArchiveIndex struct {
+	Subscriptions map[string]any `yaml:"subscriptions"`
+}
+
+func canonicalArchivedSubscriptionURL(raw string) string {
+	value := strings.TrimSpace(raw)
+	if marker := strings.Index(value, "#"); marker >= 0 {
+		value = value[:marker]
+	}
+	return strings.TrimSpace(value)
+}
+
+func filterArchivedSubscriptionURLs(urls []string, archived map[string]any) ([]string, int) {
+	if len(urls) == 0 || len(archived) == 0 {
+		return urls, 0
+	}
+
+	keys := make(map[string]struct{}, len(archived))
+	for raw := range archived {
+		if key := canonicalArchivedSubscriptionURL(raw); key != "" {
+			keys[key] = struct{}{}
+		}
+	}
+
+	filtered := make([]string, 0, len(urls))
+	skipped := 0
+	for _, raw := range urls {
+		key := canonicalArchivedSubscriptionURL(raw)
+		if _, exists := keys[key]; exists {
+			skipped++
+			continue
+		}
+		filtered = append(filtered, raw)
+	}
+	return filtered, skipped
+}
+
+func filterArchivedSilentSubscriptions(urls []string) ([]string, int, error) {
+	if len(urls) == 0 {
+		return urls, 0, nil
+	}
+
+	saver, err := method.NewStatsSaver()
+	if err != nil {
+		return urls, 0, err
+	}
+	data, err := os.ReadFile(filepath.Join(saver.StatsPath, "silent-subscriptions.yaml"))
+	if os.IsNotExist(err) {
+		return urls, 0, nil
+	}
+	if err != nil {
+		return urls, 0, err
+	}
+	if len(strings.TrimSpace(string(data))) == 0 {
+		return urls, 0, nil
+	}
+
+	var archive silentSubscriptionArchiveIndex
+	if err := yaml.Unmarshal(data, &archive); err != nil {
+		return urls, 0, err
+	}
+	filtered, skipped := filterArchivedSubscriptionURLs(urls, archive.Subscriptions)
+	return filtered, skipped, nil
+}
