+// SyncSilentSubscriptionArchive imports all existing delete suggestions into a
+// dedicated, persistent archive. It is called at startup so an existing health
+// history is immediately available for duplicate checks without another test.
+func SyncSilentSubscriptionArchive() error {
+	history, err := loadSubscriptionHealthHistory()
+	if err != nil {
+		return err
+	}
+	return syncSilentSubscriptionArchive(history)
+}
+
+func syncSilentSubscriptionArchive(history *subscriptionHealthHistory) error {
+	archive, err := loadSilentSubscriptionArchive()
+	if err != nil {
+		return err
+	}
+	mergeSilentSubscriptionArchive(archive, history)
+
+	data, err := yaml.Marshal(archive)
+	if err != nil {
+		return fmt.Errorf("编码沉默订阅档案: %w", err)
+	}
+	if err := method.SaveToStats(data, silentSubscriptionArchiveFilename, "沉默订阅档案已更新"); err != nil {
+		return err
+	}
+	return nil
+}
+
+func loadSilentSubscriptionArchive() (*silentSubscriptionArchive, error) {
+	saver, err := method.NewStatsSaver()
+	if err != nil {
+		return nil, err
+	}
+	data, err := os.ReadFile(filepath.Join(saver.StatsPath, silentSubscriptionArchiveFilename))
+	if os.IsNotExist(err) {
+		return newSilentSubscriptionArchive(), nil
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	archive := newSilentSubscriptionArchive()
+	if len(strings.TrimSpace(string(data))) == 0 {
+		return archive, nil
+	}
+	if err := yaml.Unmarshal(data, archive); err != nil {
+		return nil, err
+	}
+	if archive.Subscriptions == nil {
+		archive.Subscriptions = make(map[string]silentSubscriptionArchiveRecord)
+	}
+	if archive.Version == 0 {
+		archive.Version = 1
+	}
+	if archive.Threshold == 0 {
+		archive.Threshold = subscriptionDeleteThreshold
+	}
+	return archive, nil
+}
+
+func mergeSilentSubscriptionArchive(archive *silentSubscriptionArchive, history *subscriptionHealthHistory) {
+	if archive.Subscriptions == nil {
+		archive.Subscriptions = make(map[string]silentSubscriptionArchiveRecord)
+	}
+	archive.Version = 1
+	archive.Threshold = subscriptionDeleteThreshold
+	if history == nil {
+		return
+	}
+
+	changed := false
+	for subURL, health := range history.Subscriptions {
+		if !subscriptionDeleteSuggested(health) {
+			continue
+		}
+		record, exists := archive.Subscriptions[subURL]
+		if !exists || record.ArchivedAt == "" {
+			record.ArchivedAt = health.LastCheckedAt
+		}
+		record.LastCheckedAt = health.LastCheckedAt
+		record.LastSilentAt = health.LastSilentAt
+		record.ConsecutiveSilent = health.ConsecutiveSilent
+		record.LastTotal = health.LastTotal
+		record.Reason = silentSubscriptionArchiveReason
+		archive.Subscriptions[subURL] = record
+		changed = true
+	}
+	if changed {
+		archive.UpdatedAt = history.UpdatedAt
+		if archive.UpdatedAt == "" {
+			archive.UpdatedAt = time.Now().Format(time.RFC3339)
+		}
+	}
+}
+
+func canonicalSubscriptionURL(raw string) string {
+	value := strings.TrimSpace(raw)
+	if marker := strings.Index(value, "#"); marker >= 0 {
+		value = value[:marker]
+	}
+	return strings.TrimSpace(value)
+}
+
+// NewSubscriptionURLs returns only links newly introduced by a config update.
+// Remarks after # are ignored so changing a display tag is not treated as a
+// new subscription.
+func NewSubscriptionURLs(previous, next []string) []string {
+	existing := make(map[string]struct{}, len(previous))
+	for _, raw := range previous {
+		if key := canonicalSubscriptionURL(raw); key != "" {
+			existing[key] = struct{}{}
+		}
+	}
+
+	seen := make(map[string]struct{}, len(next))
+	var added []string
+	for _, raw := range next {
+		key := canonicalSubscriptionURL(raw)
+		if key == "" {
+			continue
+		}
+		if _, ok := existing[key]; ok {
+			continue
+		}
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		added = append(added, raw)
+	}
+	return added
+}
+
+func matchArchivedSilentSubscriptions(archive *silentSubscriptionArchive, urls []string) []string {
+	archived := make(map[string]struct{}, len(archive.Subscriptions))
+	for raw := range archive.Subscriptions {
+		if key := canonicalSubscriptionURL(raw); key != "" {
+			archived[key] = struct{}{}
+		}
+	}
+	var matches []string
+	for _, raw := range urls {
+		if _, ok := archived[canonicalSubscriptionURL(raw)]; ok {
+			matches = append(matches, raw)
+		}
+	}
+	return matches
+}
+
+// FindArchivedSilentSubscriptions checks prospective new links against the
+// persistent low-quality archive used by the configuration API.
+func FindArchivedSilentSubscriptions(urls []string) ([]string, error) {
+	if len(urls) == 0 {
+		return nil, nil
+	}
+	archive, err := loadSilentSubscriptionArchive()
+	if err != nil {
+		return nil, err
+	}
+	return matchArchivedSilentSubscriptions(archive, urls), nil
+}
