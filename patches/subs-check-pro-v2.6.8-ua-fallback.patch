+func isStructurallyValidSubscriptionNode(node map[string]any) bool {
+	serverStr := strings.TrimSpace(fmt.Sprintf("%v", node["server"]))
+	port := parse.ToIntPort(node["port"])
+	return serverStr != "" && serverStr != "<nil>" &&
+		port > 0 && port <= 65535 && node["type"] != nil
+}
+
+func subscriptionHostname(subURL string) string {
+	parsedURL, err := url.Parse(parse.CleanURL(subURL))
+	if err != nil {
+		return ""
+	}
+	return parsedURL.Hostname()
+}
