@@ -0,0 +1,233 @@
+package proxies
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+	"github.com/sinspired/subs-check-pro/v2/proxy/parse"
+)
+
+func malformedSubscriptionHTML() []byte {
+	return []byte(`<!doctype html><html><body>
+<a href="clash://install-config?url=https%3A%2F%2Fsubscription.example&name=clash">Open Clash</a>
+<script>window.__CF$cv$params = {r:'abc',t:'MT',m:'not-a-port'};</script>
+<script src="https://static.example/beacon.min.js"></script>
+</body></html>`)
+}
+
+func TestProcessSubscriptionRetriesClientUAAfterOnlyMalformedCandidates(t *testing.T) {
+	originalConfig := config.GlobalConfig
+	config.GlobalConfig = &config.Config{
+		SubUrlsReTry:   1,
+		SubUrlsTimeout: 10,
+		SystemProxy:    "direct",
+	}
+	t.Cleanup(func() {
+		config.GlobalConfig = originalConfig
+		ClearFetchCache()
+	})
+
+	var fixtureRawHits, fixtureStructuralHits int
+	_, _ = parseSubscriptionFixture(malformedSubscriptionHTML(), func(node map[string]any) bool {
+		fixtureRawHits++
+		if isStructurallyValidSubscriptionNode(node) {
+			fixtureStructuralHits++
+		}
+		return true
+	})
+	if fixtureRawHits == 0 || fixtureStructuralHits != 0 {
+		t.Fatalf("malformed HTML fixture produced raw=%d structural=%d, want raw>0 structural=0", fixtureRawHits, fixtureStructuralHits)
+	}
+
+	var (
+		mu      sync.Mutex
+		seenUAs []string
+	)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seenUAs = append(seenUAs, r.UserAgent())
+		mu.Unlock()
+
+		if r.UserAgent() != "clash.meta" {
+			w.Header().Set("Content-Type", "text/html")
+			_, _ = w.Write(malformedSubscriptionHTML())
+			return
+		}
+
+		_, _ = w.Write([]byte(`proxies:
+  - name: compatible
+    type: ss
+    server: 192.0.2.1
+    port: 443
+    cipher: aes-128-gcm
+    password: test
+`))
+	}))
+	t.Cleanup(server.Close)
+
+	out := make(chan []map[string]any, 1)
+	processSubscription(server.URL+"/sub", "", false, false, out, 10)
+
+	select {
+	case batch := <-out:
+		if len(batch) != 1 || batch[0]["name"] != "compatible" {
+			t.Fatalf("unexpected parsed batch: %+v", batch)
+		}
+	default:
+		t.Fatal("compatible UA did not produce a proxy batch")
+	}
+
+	mu.Lock()
+	gotUAs := append([]string(nil), seenUAs...)
+	mu.Unlock()
+	if len(gotUAs) < 2 || gotUAs[0] != "mihomo/1.19.27" || !slices.Contains(gotUAs, "clash.meta") {
+		t.Fatalf("UA fallback sequence = %v", gotUAs)
+	}
+}
+
+func parseSubscriptionFixture(data []byte, yield func(map[string]any) bool) (map[string]int, error) {
+	return parse.ParseSubscriptionDataStream(data, "https://subscription.example", yield)
+}
+
+func TestProcessSubscriptionContinuesAfterMalformedFallbackUA(t *testing.T) {
+	originalConfig := config.GlobalConfig
+	config.GlobalConfig = &config.Config{
+		SubUrlsReTry:   1,
+		SubUrlsTimeout: 10,
+		SystemProxy:    "direct",
+	}
+	t.Cleanup(func() {
+		config.GlobalConfig = originalConfig
+		ClearFetchCache()
+	})
+
+	var (
+		mu      sync.Mutex
+		seenUAs []string
+	)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seenUAs = append(seenUAs, r.UserAgent())
+		mu.Unlock()
+
+		if r.UserAgent() != "ClashMetaForAndroid/2.11.30" {
+			_, _ = w.Write(malformedSubscriptionHTML())
+			return
+		}
+
+		_, _ = w.Write([]byte(`proxies:
+  - name: android-compatible
+    type: ss
+    server: 192.0.2.3
+    port: 443
+    cipher: aes-128-gcm
+    password: test
+`))
+	}))
+	t.Cleanup(server.Close)
+
+	out := make(chan []map[string]any, 1)
+	processSubscription(server.URL+"/sub", "", false, false, out, 10)
+
+	select {
+	case batch := <-out:
+		if len(batch) != 1 || batch[0]["name"] != "android-compatible" {
+			t.Fatalf("unexpected parsed batch: %+v", batch)
+		}
+	default:
+		t.Fatal("second compatible UA did not produce a proxy batch")
+	}
+
+	mu.Lock()
+	gotUAs := append([]string(nil), seenUAs...)
+	mu.Unlock()
+	if !slices.Contains(gotUAs, "clash.meta") || !slices.Contains(gotUAs, "ClashMetaForAndroid/2.11.30") {
+		t.Fatalf("UA fallback sequence = %v", gotUAs)
+	}
+}
+
+func TestShouldRetrySubscriptionWithClientUASkipsGitHub(t *testing.T) {
+	if shouldRetrySubscriptionWithClientUA("https://raw.githubusercontent.com/example/repo/main/sub.yaml") {
+		t.Fatal("GitHub raw subscriptions should not receive redundant UA retries")
+	}
+	if !shouldRetrySubscriptionWithClientUA("https://subscription.example/sub") {
+		t.Fatal("ordinary subscriptions should allow client UA retries")
+	}
+}
+
+func TestProcessSubscriptionDoesNotRetryValidFirstResponse(t *testing.T) {
+	originalConfig := config.GlobalConfig
+	config.GlobalConfig = &config.Config{
+		SubUrlsReTry:   1,
+		SubUrlsTimeout: 10,
+		SystemProxy:    "direct",
+	}
+	t.Cleanup(func() {
+		config.GlobalConfig = originalConfig
+		ClearFetchCache()
+	})
+
+	var requestCount atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount.Add(1)
+		_, _ = w.Write([]byte(`proxies:
+  - name: first-response
+    type: ss
+    server: 192.0.2.2
+    port: 443
+    cipher: aes-128-gcm
+    password: test
+`))
+	}))
+	t.Cleanup(server.Close)
+
+	out := make(chan []map[string]any, 1)
+	processSubscription(server.URL+"/sub", "", false, false, out, 10)
+	if requestCount.Load() != 1 {
+		t.Fatalf("valid subscription requests = %d, want 1", requestCount.Load())
+	}
+}
+
+func TestProcessSubscriptionDoesNotRetryStructurallyValidFilteredResponse(t *testing.T) {
+	originalConfig := config.GlobalConfig
+	config.GlobalConfig = &config.Config{
+		SubUrlsReTry:   1,
+		SubUrlsTimeout: 10,
+		SystemProxy:    "direct",
+		NodeType:       []string{"vless"},
+	}
+	t.Cleanup(func() {
+		config.GlobalConfig = originalConfig
+		ClearFetchCache()
+	})
+
+	var requestCount atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount.Add(1)
+		_, _ = w.Write([]byte(`proxies:
+  - name: filtered-ss
+    type: ss
+    server: 192.0.2.4
+    port: 443
+    cipher: aes-128-gcm
+    password: test
+`))
+	}))
+	t.Cleanup(server.Close)
+
+	out := make(chan []map[string]any, 1)
+	processSubscription(server.URL+"/sub", "", false, false, out, 10)
+	if requestCount.Load() != 1 {
+		t.Fatalf("structurally valid filtered subscription requests = %d, want 1", requestCount.Load())
+	}
+	select {
+	case batch := <-out:
+		t.Fatalf("filtered response unexpectedly produced a batch: %+v", batch)
+	default:
+	}
+}

