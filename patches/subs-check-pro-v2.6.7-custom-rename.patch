@@ -0,0 +1,25 @@
+package proxies
+
+import "testing"
+
+func TestRenameChineseCountryWithPaddedCounterAndMultiplier(t *testing.T) {
+	ResetRenameCounter()
+
+	tests := []struct {
+		country string
+		origin  string
+		want    string
+	}{
+		{"HK", "香港节点 | 1x", "🇭🇰 香港 01 | 1x"},
+		{"HK", "香港节点_0.5X_专线", "🇭🇰 香港 02 | 0.5x"},
+		{"HK", "香港节点 2倍", "🇭🇰 香港 03 | 2x"},
+		{"HK", "香港节点", "🇭🇰 香港 04"},
+		{"US", "US node | × 3", "🇺🇸 美国 01 | 3x"},
+	}
+
+	for _, test := range tests {
+		if got := Rename(test.country, "", test.origin); got != test.want {
+			t.Fatalf("Rename(%q, %q) = %q, want %q", test.country, test.origin, got, test.want)
+		}
+	}
+}
