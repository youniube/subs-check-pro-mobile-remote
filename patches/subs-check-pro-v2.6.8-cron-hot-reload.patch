diff --git a/app/config_reload_test.go b/app/config_reload_test.go
new file mode 100644
index 0000000..d4d79dd
--- /dev/null
+++ b/app/config_reload_test.go
@@ -0,0 +1,70 @@
+package app
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+func TestConfigReloadRepairsStaleCronTimer(t *testing.T) {
+	originalConfig := *config.GlobalConfig
+	defer func() {
+		*config.GlobalConfig = originalConfig
+	}()
+
+	const (
+		oldCron = "30 5 * * *"
+		newCron = "0 5,19 * * *"
+	)
+
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	configData := []byte("cron-expression: \"" + newCron + "\"\ncheck-interval: 10080\n")
+	if err := os.WriteFile(configPath, configData, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	*config.GlobalConfig = config.Config{
+		CronExpression: oldCron,
+		CheckInterval:  10080,
+	}
+	app := New("test", "test", configPath)
+	app.interval = normalizedCheckInterval(config.GlobalConfig.CheckInterval)
+	app.setTimer()
+	t.Cleanup(func() {
+		if app.cron != nil {
+			app.cron.Stop()
+		}
+		if app.ticker != nil {
+			app.ticker.Stop()
+		}
+	})
+
+	staleCron := app.cron
+	if staleCron == nil {
+		t.Fatal("old cron scheduler was not created")
+	}
+
+	// Reproduce the field evidence: the global config already contains the saved
+	// expression while the scheduler still runs the previous expression.
+	config.GlobalConfig.CronExpression = newCron
+	app.onConfigChange()
+
+	if app.cron == nil {
+		t.Fatal("new cron scheduler was not created")
+	}
+	if app.cron == staleCron {
+		t.Fatal("stale cron scheduler was not replaced")
+	}
+	appliedCron, _ := app.appliedTimerCron.Load().(string)
+	if appliedCron != newCron {
+		t.Fatalf("applied cron = %q, want %q", appliedCron, newCron)
+	}
+	if app.appliedTimerInterval.Load() != 10080 {
+		t.Fatalf("applied interval = %d, want 10080", app.appliedTimerInterval.Load())
+	}
+	if got := config.GlobalConfig.CronExpression; got != newCron {
+		t.Fatalf("loaded cron = %q, want %q", got, newCron)
+	}
+}
