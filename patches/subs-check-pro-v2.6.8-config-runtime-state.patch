diff --git a/app/config_runtime.go b/app/config_runtime.go
new file mode 100644
index 0000000..e97a5d5
--- /dev/null
+++ b/app/config_runtime.go
@@ -0,0 +1,129 @@
+package app
+
+import (
+	"reflect"
+	"slices"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+const (
+	configStateApplied        = "applied"
+	configStatePendingNextRun = "pending-next-run"
+	configStateRestartNeeded  = "restart-required"
+)
+
+type configApplyStatus struct {
+	State           string   `json:"state"`
+	DesiredVersion  uint64   `json:"desired_version"`
+	AppliedVersion  uint64   `json:"applied_version"`
+	CheckVersion    uint64   `json:"check_version,omitempty"`
+	Pending         bool     `json:"pending"`
+	RestartRequired []string `json:"restart_required"`
+}
+
+func cloneConfig(src *config.Config) *config.Config {
+	if src == nil {
+		return nil
+	}
+	dst := *src
+	dst.SubUrlsRemote = slices.Clone(src.SubUrlsRemote)
+	dst.SubUrls = slices.Clone(src.SubUrls)
+	dst.RecipientURL = slices.Clone(src.RecipientURL)
+	dst.Platforms = slices.Clone(src.Platforms)
+	dst.NodeType = slices.Clone(src.NodeType)
+	dst.NodeLoc = slices.Clone(src.NodeLoc)
+	dst.GithubProxyGroup = slices.Clone(src.GithubProxyGroup)
+	dst.SubProcess.RegexFilter = slices.Clone(src.SubProcess.RegexFilter)
+	dst.SubProcess.RegexSort = slices.Clone(src.SubProcess.RegexSort)
+	return &dst
+}
+
+func configsEqual(a, b *config.Config) bool {
+	return reflect.DeepEqual(a, b)
+}
+
+func (app *App) beginCheck() bool {
+	app.configReloadMu.Lock()
+	defer app.configReloadMu.Unlock()
+
+	if app.checking.Load() {
+		return false
+	}
+	app.checking.Store(true)
+	app.checkConfigVersion.Store(app.appliedConfigVersion.Load())
+	return true
+}
+
+func (app *App) finishCheck() {
+	app.configReloadMu.Lock()
+	defer app.configReloadMu.Unlock()
+
+	app.checking.Store(false)
+	app.checkConfigVersion.Store(0)
+	if app.pendingConfig == nil {
+		return
+	}
+
+	next := app.pendingConfig
+	version := app.pendingConfigVersion
+	app.pendingConfig = nil
+	app.pendingConfigVersion = 0
+	app.applyRuntimeConfigLocked(next, version)
+}
+
+func (app *App) effectiveConfigLocked(desired *config.Config) *config.Config {
+	effective := cloneConfig(desired)
+	if effective == nil || app.startupConfig == nil {
+		return effective
+	}
+
+	// These values describe resources created during process startup. Until the
+	// corresponding managers support safe live reconfiguration, keep runtime
+	// consumers on the values that are actually active and report a restart.
+	effective.ListenPort = app.startupConfig.ListenPort
+	effective.EnableWebUI = app.startupConfig.EnableWebUI
+	effective.OutputDir = app.startupConfig.OutputDir
+	return effective
+}
+
+func (app *App) restartRequiredFieldsLocked() []string {
+	if app.startupConfig == nil || app.desiredConfig == nil {
+		return []string{}
+	}
+	fields := make([]string, 0, 3)
+	if app.startupConfig.ListenPort != app.desiredConfig.ListenPort {
+		fields = append(fields, "listen-port")
+	}
+	if app.startupConfig.EnableWebUI != app.desiredConfig.EnableWebUI {
+		fields = append(fields, "enable-web-ui")
+	}
+	if app.startupConfig.OutputDir != app.desiredConfig.OutputDir {
+		fields = append(fields, "output-dir")
+	}
+	return fields
+}
+
+func (app *App) configStatusLocked() configApplyStatus {
+	restartRequired := app.restartRequiredFieldsLocked()
+	state := configStateApplied
+	if app.pendingConfig != nil {
+		state = configStatePendingNextRun
+	} else if len(restartRequired) > 0 {
+		state = configStateRestartNeeded
+	}
+	return configApplyStatus{
+		State:           state,
+		DesiredVersion:  app.configVersion.Load(),
+		AppliedVersion:  app.appliedConfigVersion.Load(),
+		CheckVersion:    app.checkConfigVersion.Load(),
+		Pending:         app.pendingConfig != nil,
+		RestartRequired: restartRequired,
+	}
+}
+
+func (app *App) configStatus() configApplyStatus {
+	app.configReloadMu.Lock()
+	defer app.configReloadMu.Unlock()
+	return app.configStatusLocked()
+}
diff --git a/app/config_runtime_test.go b/app/config_runtime_test.go
new file mode 100644
index 0000000..af0e16b
--- /dev/null
+++ b/app/config_runtime_test.go
@@ -0,0 +1,226 @@
+package app
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"testing"
+
+	"github.com/sinspired/subs-check-pro/v2/config"
+)
+
+func writeRuntimeConfig(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newRuntimeConfigTestApp(t *testing.T, content string) *App {
+	t.Helper()
+	originalConfig := *config.GlobalConfig
+	t.Cleanup(func() {
+		*config.GlobalConfig = originalConfig
+	})
+
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	writeRuntimeConfig(t, configPath, content)
+	app := New("test", "test", configPath)
+	if err := app.loadConfig(); err != nil {
+		t.Fatal(err)
+	}
+	app.interval = normalizedCheckInterval(config.GlobalConfig.CheckInterval)
+	app.setTimer()
+	t.Cleanup(func() {
+		if app.cron != nil {
+			app.cron.Stop()
+		}
+		if app.ticker != nil {
+			app.ticker.Stop()
+		}
+	})
+	return app
+}
+
+func TestCloneConfigDeepCopiesSlices(t *testing.T) {
+	src := &config.Config{
+		SubUrls:          []string{"a"},
+		RecipientURL:     []string{"b"},
+		GithubProxyGroup: []string{"c"},
+		SubProcess: config.SubProcessConfig{
+			RegexFilter: []string{"d"},
+			RegexSort:   []string{"e"},
+		},
+	}
+	dst := cloneConfig(src)
+	src.SubUrls[0] = "changed"
+	src.RecipientURL[0] = "changed"
+	src.GithubProxyGroup[0] = "changed"
+	src.SubProcess.RegexFilter[0] = "changed"
+	src.SubProcess.RegexSort[0] = "changed"
+
+	if !slices.Equal(dst.SubUrls, []string{"a"}) ||
+		!slices.Equal(dst.RecipientURL, []string{"b"}) ||
+		!slices.Equal(dst.GithubProxyGroup, []string{"c"}) ||
+		!slices.Equal(dst.SubProcess.RegexFilter, []string{"d"}) ||
+		!slices.Equal(dst.SubProcess.RegexSort, []string{"e"}) {
+		t.Fatal("cloneConfig shares slice storage with its source")
+	}
+}
+
+func TestConfigReloadDefersPublicationUntilCheckFinishes(t *testing.T) {
+	const oldConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+timeout: 1000
+listen-port: "127.0.0.1:8199"
+enable-web-ui: true
+output-dir: "old-output"
+sub-store-port: ""
+`
+	const newConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+timeout: 9000
+listen-port: "127.0.0.1:8199"
+enable-web-ui: true
+output-dir: "old-output"
+sub-store-port: ""
+`
+	app := newRuntimeConfigTestApp(t, oldConfig)
+	if !app.beginCheck() {
+		t.Fatal("check did not start")
+	}
+	writeRuntimeConfig(t, app.configPath, newConfig)
+
+	status, err := app.onConfigChange()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status.State != configStatePendingNextRun || !status.Pending {
+		t.Fatalf("status = %#v, want pending-next-run", status)
+	}
+	if got := config.GlobalConfig.Timeout; got != 1000 {
+		t.Fatalf("active timeout changed during check: %d", got)
+	}
+	if status.DesiredVersion != 2 || status.AppliedVersion != 1 || status.CheckVersion != 1 {
+		t.Fatalf("unexpected versions while pending: %#v", status)
+	}
+
+	app.finishCheck()
+	if got := config.GlobalConfig.Timeout; got != 9000 {
+		t.Fatalf("pending timeout was not applied: %d", got)
+	}
+	status = app.configStatus()
+	if status.Pending || status.State != configStateApplied {
+		t.Fatalf("status after check = %#v, want applied", status)
+	}
+	if status.DesiredVersion != 2 || status.AppliedVersion != 2 || status.CheckVersion != 0 {
+		t.Fatalf("unexpected versions after apply: %#v", status)
+	}
+}
+
+func TestStartupBoundFieldsRemainOnActuallyRunningValues(t *testing.T) {
+	const oldConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+listen-port: "127.0.0.1:8199"
+enable-web-ui: true
+output-dir: "old-output"
+sub-store-port: ""
+`
+	const newConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+listen-port: "127.0.0.1:9199"
+enable-web-ui: false
+output-dir: "new-output"
+sub-store-port: ""
+`
+	app := newRuntimeConfigTestApp(t, oldConfig)
+	writeRuntimeConfig(t, app.configPath, newConfig)
+	status, err := app.onConfigChange()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if status.State != configStateRestartNeeded {
+		t.Fatalf("state = %q, want %q", status.State, configStateRestartNeeded)
+	}
+	wantRestart := []string{"listen-port", "enable-web-ui", "output-dir"}
+	if !slices.Equal(status.RestartRequired, wantRestart) {
+		t.Fatalf("restart fields = %#v, want %#v", status.RestartRequired, wantRestart)
+	}
+	if config.GlobalConfig.ListenPort != "127.0.0.1:8199" ||
+		!config.GlobalConfig.EnableWebUI ||
+		config.GlobalConfig.OutputDir != "old-output" {
+		t.Fatalf("startup-bound runtime fields changed: %#v", config.GlobalConfig)
+	}
+}
+
+func TestInvalidReloadKeepsCurrentRuntimeConfig(t *testing.T) {
+	const oldConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+timeout: 1000
+sub-store-port: ""
+`
+	app := newRuntimeConfigTestApp(t, oldConfig)
+	writeRuntimeConfig(t, app.configPath, "timeout: [not-an-integer]\n")
+
+	status, err := app.onConfigChange()
+	if err == nil {
+		t.Fatal("invalid config unexpectedly loaded")
+	}
+	if config.GlobalConfig.Timeout != 1000 {
+		t.Fatalf("runtime timeout changed after invalid reload: %d", config.GlobalConfig.Timeout)
+	}
+	if status.DesiredVersion != 1 || status.AppliedVersion != 1 || status.Pending {
+		t.Fatalf("status changed after invalid reload: %#v", status)
+	}
+}
+
+func TestConcurrentEquivalentReloadsCreateOnePendingVersion(t *testing.T) {
+	const oldConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+timeout: 1000
+sub-store-port: ""
+`
+	const newConfig = `
+cron-expression: "0 5 * * *"
+check-interval: 10080
+timeout: 2000
+sub-store-port: ""
+`
+	app := newRuntimeConfigTestApp(t, oldConfig)
+	if !app.beginCheck() {
+		t.Fatal("check did not start")
+	}
+	writeRuntimeConfig(t, app.configPath, newConfig)
+
+	var wg sync.WaitGroup
+	errs := make(chan error, 20)
+	for range 20 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := app.onConfigChange()
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	status := app.configStatus()
+	if status.DesiredVersion != 2 || status.AppliedVersion != 1 || !status.Pending {
+		t.Fatalf("equivalent reloads created extra versions: %#v", status)
+	}
+	app.finishCheck()
+}
