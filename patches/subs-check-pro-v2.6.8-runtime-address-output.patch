+func safeSharePath(basePath, requestPath string) (string, bool) {
+	baseAbs, err := filepath.Abs(basePath)
+	if err != nil {
+		return "", false
+	}
+	requestPath = strings.TrimLeft(requestPath, `/\`)
+	candidateAbs, err := filepath.Abs(filepath.Join(baseAbs, filepath.Clean(requestPath)))
+	if err != nil {
+		return "", false
+	}
+	relative, err := filepath.Rel(baseAbs, candidateAbs)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return "", false
+	}
+	return candidateAbs, true
+}
