new file mode 100644
index 0000000..ebce096
--- /dev/null
+++ b/app/output_reload_test.go
@@ -0,0 +1,101 @@
+package app
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestStaticDownloadRouteFollowsAppliedOutputDirectory(t *testing.T) {
+	oldOutput := filepath.Join(t.TempDir(), "old-output")
+	newOutput := filepath.Join(t.TempDir(), "new-output")
+	if err := os.MkdirAll(oldOutput, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(newOutput, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	const fileName = "Sinspired_Rules_CDN.yaml"
+	if err := os.WriteFile(filepath.Join(oldOutput, fileName), []byte("old-directory"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(newOutput, fileName), []byte("new-directory"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for directory, content := range map[string]string{
+		oldOutput: "old-share",
+		newOutput: "new-share",
+	} {
+		moreDir := filepath.Join(directory, ShareDirName)
+		if err := os.MkdirAll(moreDir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(moreDir, "shared.txt"), []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	configYAML := func(output string) string {
+		return fmt.Sprintf(`
+cron-expression: "0 5 * * *"
+check-interval: 10080
+listen-port: "127.0.0.1:8199"
+enable-web-ui: true
+output-dir: %q
+sub-store-port: ""
+`, filepath.ToSlash(output))
+	}
+	app := newRuntimeConfigTestApp(t, configYAML(oldOutput))
+	router := newTestRouter()
+	app.registerStaticRoutes(router)
+	shareRouter := newTestRouter()
+	shareRouter.GET(PublicPath+"/*filepath", app.handleFileShare())
+
+	assertDownload := func(target, want string, handler http.Handler) {
+		t.Helper()
+		request := httptest.NewRequest(http.MethodGet, target, nil)
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, request)
+		if response.Code != http.StatusOK || response.Body.String() != want {
+			t.Fatalf("download = (%d, %q), want (200, %q)",
+				response.Code, response.Body.String(), want)
+		}
+	}
+	assertDownload("/"+fileName, "old-directory", router)
+	assertDownload("/more/shared.txt", "old-share", shareRouter)
+
+	writeRuntimeConfig(t, app.configPath, configYAML(newOutput))
+	status, err := app.onConfigChange()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status.State != configStateApplied {
+		t.Fatalf("output-dir reload state = %q, want applied", status.State)
+	}
+	assertDownload("/"+fileName, "new-directory", router)
+	assertDownload("/more/shared.txt", "new-share", shareRouter)
+}
+
+func newTestRouter() *gin.Engine {
+	gin.SetMode(gin.TestMode)
+	return gin.New()
+}
+
+func TestSafeSharePathRejectsTraversalAndPrefixConfusion(t *testing.T) {
+	base := filepath.Join(t.TempDir(), "share")
+	if _, ok := safeSharePath(base, "../../outside.txt"); ok {
+		t.Fatal("parent traversal unexpectedly accepted")
+	}
+	if _, ok := safeSharePath(base, `..\share-evil\outside.txt`); ok {
+		t.Fatal("sibling prefix path unexpectedly accepted")
+	}
+	got, ok := safeSharePath(base, "/nested/file.txt")
+	if !ok || got != filepath.Join(base, "nested", "file.txt") {
+		t.Fatalf("safe path = %q, %v", got, ok)
+	}
+}
