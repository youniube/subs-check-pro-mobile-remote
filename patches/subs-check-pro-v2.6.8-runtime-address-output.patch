diff --git a/utils/listen_address.go b/utils/listen_address.go
new file mode 100644
index 0000000..2215744
--- /dev/null
+++ b/utils/listen_address.go
@@ -0,0 +1,56 @@
+package utils
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+)
+
+// ParseListenAddress accepts a numeric port, :port, host:port, or bracketed
+// IPv6 host:port and returns one canonical bind address plus its numeric port.
+func ParseListenAddress(value, defaultAddress string) (address, port string, err error) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		value = strings.TrimSpace(defaultAddress)
+	}
+	if value == "" {
+		return "", "", fmt.Errorf("listen address is empty")
+	}
+
+	if number, parseErr := strconv.Atoi(value); parseErr == nil {
+		if number < 1 || number > 65535 {
+			return "", "", fmt.Errorf("port is out of range: %s", value)
+		}
+		port = strconv.Itoa(number)
+		return ":" + port, port, nil
+	}
+
+	host, port, splitErr := net.SplitHostPort(value)
+	if splitErr != nil {
+		return "", "", fmt.Errorf("invalid listen address %q: %w", value, splitErr)
+	}
+	number, parseErr := strconv.Atoi(port)
+	if parseErr != nil || number < 1 || number > 65535 {
+		return "", "", fmt.Errorf("port is out of range: %s", port)
+	}
+	port = strconv.Itoa(number)
+	return net.JoinHostPort(host, port), port, nil
+}
+
+// BuildLoopbackHTTPURL uses only the numeric port from a bind address. Internal
+// clients always connect over IPv4 loopback even when the server binds a
+// specific hostname, wildcard address, or IPv6 address.
+func BuildLoopbackHTTPURL(listenAddress, defaultAddress, requestPath, fragment string) (string, error) {
+	_, port, err := ParseListenAddress(listenAddress, defaultAddress)
+	if err != nil {
+		return "", err
+	}
+	return (&url.URL{
+		Scheme:   "http",
+		Host:     net.JoinHostPort("127.0.0.1", port),
+		Path:     "/" + strings.TrimPrefix(requestPath, "/"),
+		Fragment: fragment,
+	}).String(), nil
+}
diff --git a/utils/listen_address_test.go b/utils/listen_address_test.go
new file mode 100644
index 0000000..276349c
--- /dev/null
+++ b/utils/listen_address_test.go
@@ -0,0 +1,49 @@
+package utils
+
+import "testing"
+
+func TestParseListenAddressSupportedForms(t *testing.T) {
+	tests := []struct {
+		input       string
+		wantAddress string
+		wantPort    string
+	}{
+		{input: "8199", wantAddress: ":8199", wantPort: "8199"},
+		{input: ":8199", wantAddress: ":8199", wantPort: "8199"},
+		{input: "127.0.0.1:8199", wantAddress: "127.0.0.1:8199", wantPort: "8199"},
+		{input: "[::1]:8199", wantAddress: "[::1]:8199", wantPort: "8199"},
+	}
+	for _, test := range tests {
+		t.Run(test.input, func(t *testing.T) {
+			address, port, err := ParseListenAddress(test.input, ":8199")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if address != test.wantAddress || port != test.wantPort {
+				t.Fatalf("ParseListenAddress(%q) = %q, %q; want %q, %q",
+					test.input, address, port, test.wantAddress, test.wantPort)
+			}
+		})
+	}
+}
+
+func TestBuildLoopbackHTTPURLNeverDuplicatesConfiguredHost(t *testing.T) {
+	for _, listenAddress := range []string{"8199", ":8199", "127.0.0.1:8199", "[::1]:8199"} {
+		got, err := BuildLoopbackHTTPURL(listenAddress, ":8199", "/api/subinfo", "noCache")
+		if err != nil {
+			t.Fatal(err)
+		}
+		const want = "http://127.0.0.1:8199/api/subinfo#noCache"
+		if got != want {
+			t.Fatalf("BuildLoopbackHTTPURL(%q) = %q, want %q", listenAddress, got, want)
+		}
+	}
+}
+
+func TestParseListenAddressRejectsInvalidValues(t *testing.T) {
+	for _, input := range []string{"0", "65536", "127.0.0.1", "127.0.0.1:bad", "::1:8199"} {
+		if _, _, err := ParseListenAddress(input, ""); err == nil {
+			t.Fatalf("ParseListenAddress(%q) unexpectedly succeeded", input)
+		}
+	}
+}
