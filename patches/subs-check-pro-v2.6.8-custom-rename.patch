@@ -0,0 +1,71 @@
+package proxies
+
+import "testing"
+
+func TestRenameChineseCountryWithPaddedCounterAndMultiplier(t *testing.T) {
+	ResetRenameCounter()
+
+	tests := []struct {
+		country string
+		origin  string
+		want    string
+	}{
+		{"HK", "香港节点 | 1x", "🇭🇰 香港 01 | 1x"},
+		{"HK", "香港节点_0.5X_专线", "🇭🇰 香港 02 | 0.5x"},
+		{"HK", "香港节点 2倍", "🇭🇰 香港 03 | 2x"},
+		{"HK", "香港节点", "🇭🇰 香港 04"},
+		{"US", "US node | × 3", "🇺🇸 美国 01 | 3x"},
+	}
+
+	for _, test := range tests {
+		if got := Rename(test.country, "", test.origin); got != test.want {
+			t.Fatalf("Rename(%q, %q) = %q, want %q", test.country, test.origin, got, test.want)
+		}
+	}
+}
+
+func TestInferCountryCodeFromOriginalName(t *testing.T) {
+	tests := []struct {
+		name string
+		want string
+	}{
+		{"🇺🇸US_1567|10.8MB/s|B007-260618 01", "US"},
+		{"荷兰+V2CROSS.COM", "NL"},
+		{"🇳🇱NL_12", "NL"},
+		{"United States premium node", "US"},
+		{">>@oneclickvpnkeys::US (67)", "US"},
+		{">>@oneclickvpnkeys::US-23", "US"},
+		{"provider::XX-23", ""},
+		{"provider::USA-23", ""},
+		{"provider::USfoo", ""},
+		{"provider::us-23", ""},
+		{"4Sarina-10638", ""},
+		{"🆔capoit 🔒 VL-WS-N/A ❔ XX 17ms", ""},
+	}
+
+	for _, test := range tests {
+		if got := InferCountryCode(test.name); got != test.want {
+			t.Fatalf("InferCountryCode(%q) = %q, want %q", test.name, got, test.want)
+		}
+	}
+}
+
+func TestExtractMultiplierIgnoresZero(t *testing.T) {
+	tests := []struct {
+		name string
+		want string
+	}{
+		{"node | 0x", ""},
+		{"node_0.0X_backup", ""},
+		{"node × 0", ""},
+		{"node | 0.1x", "0.1x"},
+		{"node | 01x", "1x"},
+		{"node | 00.10X", "0.1x"},
+	}
+
+	for _, test := range tests {
+		if got := extractMultiplier(test.name); got != test.want {
+			t.Fatalf("extractMultiplier(%q) = %q, want %q", test.name, got, test.want)
+		}
+	}
+}
