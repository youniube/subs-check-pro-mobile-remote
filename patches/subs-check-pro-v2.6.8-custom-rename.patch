@@ -1,18 +1,24 @@
 package proxies
 
 import (
+	"regexp"
 	"strconv"
+	"strings"
 	"sync"
 
 	"github.com/sinspired/subs-check-pro/v2/config"
+	"golang.org/x/text/language"
+	"golang.org/x/text/language/display"
 )
 
 var (
-	counter     = make(map[string]int)
-	counterLock = sync.Mutex{}
+	counter      = make(map[string]int)
+	counterLock  = sync.Mutex{}
+	delimitedCountryCodeRE = regexp.MustCompile(`::([A-Z]{2})(?:$|[^A-Za-z])`)
+	multiplierRE = regexp.MustCompile(`(?i)(?:^|[\s|/_-])(?:(\d+(?:\.\d+)?)\s*[x×倍]|[x×]\s*(\d+(?:\.\d+)?))(?:$|[\s|/_-])`)
 )
 
-func Rename(name, countryCodeTag string) string {
+func Rename(name, countryCodeTag, originName string) string {
 	flag := CountryCodeToFlag(name)
 
 	key, label := name, name
@@ -28,10 +34,169 @@ func Rename(name, countryCodeTag string) string {
 
 	counterLock.Lock()
 	counter[key]++
 	n := counter[key]
 	counterLock.Unlock()
 
-	return flag + label + "_" + strconv.Itoa(n)
+	sequence := strconv.Itoa(n)
+	if n < 10 {
+		sequence = "0" + sequence
+	}
+
+	newName := flag + " " + countryNameZH(label) + " " + sequence
+	if multiplier := extractMultiplier(originName); multiplier != "" {
+		newName += " | " + multiplier
+	}
+	return newName
+}
+
+func countryNameZH(code string) string {
+	upperCode := strings.ToUpper(code)
+	if len(upperCode) >= 2 {
+		upperCode = upperCode[:2]
+	}
+
+	// CLDR uses long administrative names for these regions. Short names are
+	// easier to scan in proxy clients and match the user's requested format.
+	if shortName, ok := map[string]string{
+		"HK": "香港",
+		"MO": "澳门",
+		"TW": "台湾",
+	}[upperCode]; ok {
+		return shortName
+	}
+
+	region, err := language.ParseRegion(upperCode)
+	if err == nil {
+		if localized := display.Regions(language.SimplifiedChinese).Name(region); localized != "" {
+			return localized
+		}
+	}
+	if code != "" {
+		return code
+	}
+	return "未知"
+}
+
+// InferCountryCode extracts a reliable ISO alpha-2 country code from the
+// original node name when IP geolocation is unavailable.
+func InferCountryCode(name string) string {
+	if code := countryCodeFromFlag(name); isCountryCode(code) {
+		return code
+	}
+	if code := leadingCountryCode(name); isCountryCode(code) {
+		return code
+	}
+	if match := delimitedCountryCodeRE.FindStringSubmatch(name); len(match) > 1 && isCountryCode(match[1]) {
+		return match[1]
+	}
+
+	lowerName := strings.ToLower(name)
+	bestCode, bestMatch := "", ""
+	for first := byte('A'); first <= byte('Z'); first++ {
+		for second := byte('A'); second <= byte('Z'); second++ {
+			code := string([]byte{first, second})
+			if !isCountryCode(code) {
+				continue
+			}
+			region, _ := language.ParseRegion(code)
+
+			chineseName := countryNameZH(code)
+			if chineseName != "" && chineseName != "未知" && strings.Contains(name, chineseName) && len(chineseName) > len(bestMatch) {
+				bestCode, bestMatch = code, chineseName
+			}
+
+			englishName := strings.ToLower(display.Regions(language.English).Name(region))
+			if containsASCIIToken(lowerName, englishName) && len(englishName) > len(bestMatch) {
+				bestCode, bestMatch = code, englishName
+			}
+		}
+	}
+	return bestCode
+}
+
+func countryCodeFromFlag(name string) string {
+	runes := []rune(name)
+	const regionalIndicatorA = rune(0x1F1E6)
+	const regionalIndicatorZ = rune(0x1F1FF)
+	for index := 0; index+1 < len(runes); index++ {
+		first, second := runes[index], runes[index+1]
+		if first < regionalIndicatorA || first > regionalIndicatorZ || second < regionalIndicatorA || second > regionalIndicatorZ {
+			continue
+		}
+		return string([]byte{
+			byte('A' + first - regionalIndicatorA),
+			byte('A' + second - regionalIndicatorA),
+		})
+	}
+	return ""
+}
+
+func leadingCountryCode(name string) string {
+	for index := 0; index < len(name); index++ {
+		current := name[index]
+		if current >= 'a' && current <= 'z' {
+			return ""
+		}
+		if current < 'A' || current > 'Z' {
+			continue
+		}
+		if index+1 >= len(name) || name[index+1] < 'A' || name[index+1] > 'Z' {
+			return ""
+		}
+		if index+2 < len(name) && isASCIILetter(name[index+2]) {
+			return ""
+		}
+		return name[index : index+2]
+	}
+	return ""
+}
+
+func isCountryCode(code string) bool {
+	if len(code) != 2 || code == "XX" {
+		return false
+	}
+	region, err := language.ParseRegion(code)
+	return err == nil && region.String() != "ZZ"
+}
+
+func containsASCIIToken(text, token string) bool {
+	if token == "" {
+		return false
+	}
+	for offset := 0; offset < len(text); {
+		relative := strings.Index(text[offset:], token)
+		if relative < 0 {
+			return false
+		}
+		start := offset + relative
+		end := start + len(token)
+		if (start == 0 || !isASCIILetter(text[start-1])) && (end == len(text) || !isASCIILetter(text[end])) {
+			return true
+		}
+		offset = start + 1
+	}
+	return false
+}
+
+func isASCIILetter(value byte) bool {
+	return value >= 'A' && value <= 'Z' || value >= 'a' && value <= 'z'
+}
+
+func extractMultiplier(name string) string {
+	match := multiplierRE.FindStringSubmatch(name)
+	if len(match) == 0 {
+		return ""
+	}
+
+	value := match[1]
+	if value == "" {
+		value = match[2]
+	}
+	parsed, err := strconv.ParseFloat(value, 64)
+	if err != nil || parsed <= 0 {
+		return ""
+	}
+	return strconv.FormatFloat(parsed, 'f', -1, 64) + "x"
 }
 
