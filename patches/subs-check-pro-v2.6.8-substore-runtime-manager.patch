new file mode 100644
index 0000000..0422b78
--- /dev/null
+++ b/app/substore_manager_test.go
@@ -0,0 +1,160 @@
+package app
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sinspired/subs-check-pro/v2/assets"
+)
+
+func waitForSubStoreStatus(t *testing.T, manager *subStoreManager, predicate func(subStoreApplyStatus) bool) subStoreApplyStatus {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		status := manager.Status()
+		if predicate(status) {
+			return status
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatalf("Sub-Store status did not converge: %#v", manager.Status())
+	return subStoreApplyStatus{}
+}
+
+func closeSubStoreManager(t *testing.T, manager *subStoreManager) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := manager.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSubStoreSubmitReturnsWithoutWaitingForProcessExit(t *testing.T) {
+	started := make(chan struct{}, 2)
+	manager := newSubStoreManager(func(ctx context.Context, _ assets.SubStoreRuntimeSpec) {
+		started <- struct{}{}
+		<-ctx.Done()
+	}, func() error { return nil })
+	defer closeSubStoreManager(t, manager)
+
+	manager.Submit(assets.SubStoreRuntimeSpec{Port: ":8299", Path: "/one"}, 1)
+	<-started
+
+	start := time.Now()
+	manager.Submit(assets.SubStoreRuntimeSpec{Port: ":8399", Path: "/two"}, 2)
+	if elapsed := time.Since(start); elapsed > 100*time.Millisecond {
+		t.Fatalf("Submit blocked for %s", elapsed)
+	}
+	waitForSubStoreStatus(t, manager, func(status subStoreApplyStatus) bool {
+		return status.AppliedVersion == 2 && !status.Pending
+	})
+}
+
+func TestSubStoreManagerCoalescesRapidChangesAndNeverOverlapsRunners(t *testing.T) {
+	var active atomic.Int32
+	var maxActive atomic.Int32
+	var mu sync.Mutex
+	var starts []assets.SubStoreRuntimeSpec
+
+	manager := newSubStoreManager(func(ctx context.Context, spec assets.SubStoreRuntimeSpec) {
+		now := active.Add(1)
+		for {
+			previous := maxActive.Load()
+			if now <= previous || maxActive.CompareAndSwap(previous, now) {
+				break
+			}
+		}
+		mu.Lock()
+		starts = append(starts, spec)
+		mu.Unlock()
+		<-ctx.Done()
+		active.Add(-1)
+	}, func() error { return nil })
+	defer closeSubStoreManager(t, manager)
+
+	for version := uint64(1); version <= 10; version++ {
+		manager.Submit(assets.SubStoreRuntimeSpec{
+			Port:        fmt.Sprintf(":%d", 8299+version),
+			Path:        "/latest",
+			SyncCron:    "1 * * * *",
+			ProduceCron: "2 * * * *",
+			PushService: "https://example.invalid/push",
+		}, version)
+	}
+
+	status := waitForSubStoreStatus(t, manager, func(status subStoreApplyStatus) bool {
+		return status.AppliedVersion == 10 && !status.Pending
+	})
+	if maxActive.Load() != 1 {
+		t.Fatalf("maximum concurrent runners = %d, want 1", maxActive.Load())
+	}
+	mu.Lock()
+	last := starts[len(starts)-1]
+	mu.Unlock()
+	if status.AppliedPort != last.Port {
+		t.Fatalf("applied port = %q, last runner port = %q", status.AppliedPort, last.Port)
+	}
+}
+
+func TestSubStoreRuntimeSpecChangesTriggerReconcile(t *testing.T) {
+	started := make(chan assets.SubStoreRuntimeSpec, 8)
+	manager := newSubStoreManager(func(ctx context.Context, spec assets.SubStoreRuntimeSpec) {
+		started <- spec
+		<-ctx.Done()
+	}, func() error { return nil })
+	defer closeSubStoreManager(t, manager)
+
+	specs := []assets.SubStoreRuntimeSpec{
+		{Port: ":8299", Path: "/one"},
+		{Port: ":8399", Path: "/one"},
+		{Port: ":8399", Path: "/two"},
+		{Port: ":8399", Path: "/two", SyncCron: "1 * * * *"},
+		{Port: ":8399", Path: "/two", SyncCron: "1 * * * *", ProduceCron: "2 * * * *"},
+		{Port: ":8399", Path: "/two", SyncCron: "1 * * * *", ProduceCron: "2 * * * *", PushService: "push"},
+		{Port: ":8399", Path: "/two", SyncCron: "1 * * * *", ProduceCron: "2 * * * *", PushService: "push", MihomoOverwriteURL: "http://127.0.0.1:9090"},
+	}
+	for index, spec := range specs {
+		version := uint64(index + 1)
+		manager.Submit(spec, version)
+		select {
+		case got := <-started:
+			if got != spec {
+				t.Fatalf("runner spec = %#v, want %#v", got, spec)
+			}
+		case <-time.After(time.Second):
+			t.Fatalf("spec version %d was not started", version)
+		}
+	}
+}
+
+func TestSubStoreManagerUsesKillFallbackAfterStopTimeout(t *testing.T) {
+	release := make(chan struct{})
+	var killCalls atomic.Int32
+	manager := newSubStoreManager(func(_ context.Context, _ assets.SubStoreRuntimeSpec) {
+		<-release
+	}, func() error {
+		if killCalls.Add(1) == 1 {
+			close(release)
+		}
+		return nil
+	})
+	manager.stopTimeout = 20 * time.Millisecond
+	defer closeSubStoreManager(t, manager)
+
+	manager.Submit(assets.SubStoreRuntimeSpec{Port: ":8299"}, 1)
+	waitForSubStoreStatus(t, manager, func(status subStoreApplyStatus) bool {
+		return status.AppliedVersion == 1
+	})
+	manager.Submit(assets.SubStoreRuntimeSpec{}, 2)
+	waitForSubStoreStatus(t, manager, func(status subStoreApplyStatus) bool {
+		return status.AppliedVersion == 2 && status.State == subStoreStateDisabled
+	})
+	if killCalls.Load() != 1 {
+		t.Fatalf("kill fallback calls = %d, want 1", killCalls.Load())
+	}
+}
