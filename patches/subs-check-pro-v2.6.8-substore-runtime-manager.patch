diff --git a/app/substore_manager.go b/app/substore_manager.go
new file mode 100644
index 0000000..c077b1d
--- /dev/null
+++ b/app/substore_manager.go
@@ -0,0 +1,310 @@
+package app
+
+import (
+	"context"
+	"log/slog"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sinspired/subs-check-pro/v2/assets"
+	"github.com/sinspired/subs-check-pro/v2/config"
+	"github.com/sinspired/subs-check-pro/v2/utils"
+)
+
+const (
+	subStoreStateDisabled    = "disabled"
+	subStoreStateRunning     = "running"
+	subStoreStateReconciling = "reconciling"
+	subStoreStateError       = "error"
+)
+
+type subStoreApplyStatus struct {
+	State          string `json:"state"`
+	DesiredVersion uint64 `json:"desired_version"`
+	AppliedVersion uint64 `json:"applied_version"`
+	Pending        bool   `json:"pending"`
+	WaitingReason  string `json:"waiting_reason,omitempty"`
+	LastError      string `json:"last_error,omitempty"`
+	ActiveProcess  bool   `json:"active_process"`
+	DesiredPort    string `json:"desired_port,omitempty"`
+	AppliedPort    string `json:"applied_port,omitempty"`
+}
+
+type subStoreRequest struct {
+	spec    assets.SubStoreRuntimeSpec
+	version uint64
+}
+
+type subStoreRunner func(context.Context, assets.SubStoreRuntimeSpec)
+type subStoreKiller func() error
+
+// subStoreManager owns the only Sub-Store supervisor goroutine. Config reloads
+// merely replace the desired request in its one-slot mailbox and return.
+type subStoreManager struct {
+	ctx         context.Context
+	cancel      context.CancelFunc
+	requests    chan subStoreRequest
+	done        chan struct{}
+	run         subStoreRunner
+	kill        subStoreKiller
+	stopTimeout time.Duration
+
+	submitMu    sync.Mutex
+	statusMu    sync.RWMutex
+	status      subStoreApplyStatus
+	appliedSpec assets.SubStoreRuntimeSpec
+}
+
+func newSubStoreManager(run subStoreRunner, kill subStoreKiller) *subStoreManager {
+	ctx, cancel := context.WithCancel(context.Background())
+	manager := &subStoreManager{
+		ctx:         ctx,
+		cancel:      cancel,
+		requests:    make(chan subStoreRequest, 1),
+		done:        make(chan struct{}),
+		run:         run,
+		kill:        kill,
+		stopTimeout: 3 * time.Second,
+		status: subStoreApplyStatus{
+			State: subStoreStateDisabled,
+		},
+	}
+	go manager.loop()
+	return manager
+}
+
+func (manager *subStoreManager) Submit(spec assets.SubStoreRuntimeSpec, version uint64) {
+	if strings.TrimSpace(spec.Port) == "" {
+		spec = assets.SubStoreRuntimeSpec{}
+	}
+	request := subStoreRequest{spec: spec, version: version}
+
+	manager.submitMu.Lock()
+	defer manager.submitMu.Unlock()
+
+	manager.statusMu.Lock()
+	manager.status.DesiredVersion = version
+	manager.status.DesiredPort = spec.Port
+	if !manager.status.Pending && spec == manager.appliedSpec {
+		manager.status.AppliedVersion = version
+		manager.status.AppliedPort = spec.Port
+		manager.status.Pending = false
+		manager.status.WaitingReason = ""
+		manager.status.LastError = ""
+		if strings.TrimSpace(spec.Port) == "" {
+			manager.status.State = subStoreStateDisabled
+			manager.status.ActiveProcess = false
+		} else {
+			manager.status.State = subStoreStateRunning
+			manager.status.ActiveProcess = true
+		}
+		manager.statusMu.Unlock()
+		return
+	}
+	manager.status.Pending = manager.status.AppliedVersion != version
+	if manager.status.Pending {
+		manager.status.State = subStoreStateReconciling
+		manager.status.WaitingReason = "applying-latest-runtime-spec"
+	}
+	manager.statusMu.Unlock()
+
+	select {
+	case manager.requests <- request:
+	default:
+		<-manager.requests
+		manager.requests <- request
+	}
+}
+
+func (manager *subStoreManager) Status() subStoreApplyStatus {
+	manager.statusMu.RLock()
+	defer manager.statusMu.RUnlock()
+	return manager.status
+}
+
+func (manager *subStoreManager) Close(ctx context.Context) error {
+	manager.cancel()
+	select {
+	case <-manager.done:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (manager *subStoreManager) setStatus(update func(*subStoreApplyStatus)) {
+	manager.statusMu.Lock()
+	defer manager.statusMu.Unlock()
+	update(&manager.status)
+}
+
+func (manager *subStoreManager) latestRequest(first subStoreRequest) subStoreRequest {
+	latest := first
+	for {
+		select {
+		case latest = <-manager.requests:
+		default:
+			return latest
+		}
+	}
+}
+
+func (manager *subStoreManager) stopActive(cancel context.CancelFunc, done <-chan struct{}) {
+	cancel()
+	timer := time.NewTimer(manager.stopTimeout)
+	defer timer.Stop()
+
+	select {
+	case <-done:
+		return
+	case <-timer.C:
+		manager.setStatus(func(status *subStoreApplyStatus) {
+			status.WaitingReason = "graceful-stop-timeout"
+		})
+		if err := manager.kill(); err != nil {
+			manager.setStatus(func(status *subStoreApplyStatus) {
+				status.LastError = err.Error()
+			})
+			slog.Error("Sub-Store fallback cleanup failed", "error", err)
+		}
+	}
+
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		manager.setStatus(func(status *subStoreApplyStatus) {
+			status.LastError = "sub-store runner did not exit after fallback cleanup"
+		})
+	}
+}
+
+func (manager *subStoreManager) loop() {
+	defer close(manager.done)
+
+	var activeSpec assets.SubStoreRuntimeSpec
+	var activeVersion uint64
+	var activeCancel context.CancelFunc
+	var activeDone <-chan struct{}
+
+	for {
+		select {
+		case <-manager.ctx.Done():
+			if activeCancel != nil {
+				manager.stopActive(activeCancel, activeDone)
+			}
+			manager.setStatus(func(status *subStoreApplyStatus) {
+				status.State = subStoreStateDisabled
+				status.Pending = false
+				status.ActiveProcess = false
+				status.WaitingReason = ""
+			})
+			return
+
+		case request := <-manager.requests:
+			request = manager.latestRequest(request)
+
+			if activeCancel != nil && request.spec == activeSpec {
+				activeVersion = request.version
+				manager.setStatus(func(status *subStoreApplyStatus) {
+					manager.appliedSpec = activeSpec
+					status.State = subStoreStateRunning
+					status.AppliedVersion = activeVersion
+					status.AppliedPort = activeSpec.Port
+					status.Pending = false
+					status.ActiveProcess = true
+					status.WaitingReason = ""
+					status.LastError = ""
+				})
+				continue
+			}
+
+			if activeCancel != nil {
+				manager.setStatus(func(status *subStoreApplyStatus) {
+					status.State = subStoreStateReconciling
+					status.WaitingReason = "stopping-previous-process"
+				})
+				manager.stopActive(activeCancel, activeDone)
+				activeCancel = nil
+				activeDone = nil
+			}
+
+			request = manager.latestRequest(request)
+			if strings.TrimSpace(request.spec.Port) == "" {
+				activeSpec = assets.SubStoreRuntimeSpec{}
+				activeVersion = request.version
+				manager.setStatus(func(status *subStoreApplyStatus) {
+					manager.appliedSpec = assets.SubStoreRuntimeSpec{}
+					status.State = subStoreStateDisabled
+					status.AppliedVersion = request.version
+					status.AppliedPort = ""
+					status.Pending = false
+					status.ActiveProcess = false
+					status.WaitingReason = ""
+					status.LastError = ""
+				})
+				continue
+			}
+
+			runCtx, cancel := context.WithCancel(manager.ctx)
+			done := make(chan struct{})
+			activeSpec = request.spec
+			activeVersion = request.version
+			activeCancel = cancel
+			activeDone = done
+			manager.setStatus(func(status *subStoreApplyStatus) {
+				manager.appliedSpec = request.spec
+				status.State = subStoreStateRunning
+				status.AppliedVersion = request.version
+				status.AppliedPort = request.spec.Port
+				status.Pending = false
+				status.ActiveProcess = true
+				status.WaitingReason = ""
+				status.LastError = ""
+			})
+			go func(spec assets.SubStoreRuntimeSpec) {
+				defer close(done)
+				manager.run(runCtx, spec)
+			}(request.spec)
+
+		case <-activeDone:
+			activeCancel = nil
+			activeDone = nil
+			manager.setStatus(func(status *subStoreApplyStatus) {
+				status.State = subStoreStateError
+				status.ActiveProcess = false
+				status.LastError = "sub-store supervisor exited unexpectedly"
+			})
+		}
+	}
+}
+
+func (app *App) normalizeSubStorePathLocked(candidate string) string {
+	path := strings.TrimSpace(candidate)
+	if path == "" && app.appliedConfig != nil {
+		path = strings.TrimSpace(app.appliedConfig.SubStorePath)
+	}
+	if path == "" {
+		if app.subStoreGeneratedPath == "" {
+			app.subStoreGeneratedPath = "/" + utils.GenerateRandomString(20)
+		}
+		path = app.subStoreGeneratedPath
+	}
+	if !strings.HasPrefix(path, "/") {
+		path = "/" + path
+	}
+	return path
+}
+
+func (app *App) subStoreSpecLocked(runtimeConfig *config.Config) assets.SubStoreRuntimeSpec {
+	runtimeConfig.SubStorePath = app.normalizeSubStorePathLocked(runtimeConfig.SubStorePath)
+	return assets.SubStoreRuntimeSpec{
+		ListenPort:         runtimeConfig.ListenPort,
+		Port:               runtimeConfig.SubStorePort,
+		Path:               runtimeConfig.SubStorePath,
+		SyncCron:           runtimeConfig.SubStoreSyncCron,
+		ProduceCron:        runtimeConfig.SubStoreProduceCron,
+		PushService:        runtimeConfig.SubStorePushService,
+		MihomoOverwriteURL: runtimeConfig.MihomoOverwriteURL,
+	}
+}
