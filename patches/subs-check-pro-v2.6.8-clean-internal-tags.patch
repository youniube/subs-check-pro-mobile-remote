--- a/proxy/proxies.go
+++ b/proxy/proxies.go
@@ -584,6 +584,12 @@ func identifyLocalSubType(subURL, listenPort, storePort string) (isLatest, isHi
 	path := u.Path
 	isLatest = strings.HasSuffix(path, "/all.yaml") || strings.HasSuffix(path, "/all.yml")
 	isHistory = strings.HasSuffix(path, "/history.yaml") || strings.HasSuffix(path, "/history.yml")
+
+	// Succeed and History are internal source markers used only to preserve
+	// deduplication priority. They must not leak into exported proxy names.
+	if isLatest || isHistory {
+		tag = ""
+	}
 
 	return isLatest, isHistory, tag
 }
