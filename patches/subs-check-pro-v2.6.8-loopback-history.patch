+// normalizeListenPort accepts the port-only values used by upstream as well as
+// host-qualified listen addresses used to restrict the WebUI to loopback.
+func normalizeListenPort(listenAddress string) string {
+	listenAddress = strings.TrimSpace(listenAddress)
+	if _, port, err := net.SplitHostPort(listenAddress); err == nil {
+		return port
+	}
+	return strings.TrimPrefix(listenAddress, ":")
+}
+
+// localSubscriptionURL always connects through IPv4 loopback. The configured
+// host controls where the WebUI listens; only its numeric port belongs in this
+// internal URL.
+func localSubscriptionURL(listenAddress, filename string) string {
+	return (&url.URL{
+		Scheme: "http",
+		Host:   net.JoinHostPort("127.0.0.1", normalizeListenPort(listenAddress)),
+		Path:   "/" + strings.TrimPrefix(filename, "/"),
+	}).String()
+}
