@@ -0,0 +1,74 @@
+package proxies
+
+import "testing"
+
+func TestNormalizeListenPort(t *testing.T) {
+	tests := map[string]string{
+		"8199":           "8199",
+		":8199":          "8199",
+		"127.0.0.1:8199": "8199",
+		"localhost:8199": "8199",
+		"[::1]:8199":     "8199",
+		" 127.0.0.1:8199 ": "8199",
+	}
+
+	for input, want := range tests {
+		t.Run(input, func(t *testing.T) {
+			if got := normalizeListenPort(input); got != want {
+				t.Fatalf("normalizeListenPort(%q) = %q, want %q", input, got, want)
+			}
+		})
+	}
+}
+
+func TestLocalSubscriptionURLWithLoopbackQualifiedListenAddress(t *testing.T) {
+	tests := []struct {
+		filename string
+		want     string
+	}{
+		{filename: "all.yaml", want: "http://127.0.0.1:8199/all.yaml"},
+		{filename: "history.yaml", want: "http://127.0.0.1:8199/history.yaml"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.filename, func(t *testing.T) {
+			got := localSubscriptionURL("127.0.0.1:8199", test.filename)
+			if got != test.want {
+				t.Fatalf("localSubscriptionURL() = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestIdentifyLocalSubTypeWithQualifiedConfiguredPort(t *testing.T) {
+	listenPort := normalizeListenPort("127.0.0.1:8199")
+	storePort := normalizeListenPort("8299")
+
+	tests := []struct {
+		url         string
+		wantLatest  bool
+		wantHistory bool
+		wantTag     string
+	}{
+		{
+			url:        "http://127.0.0.1:8199/all.yaml#Succeed",
+			wantLatest: true,
+			wantTag:    "Succeed",
+		},
+		{
+			url:         "http://127.0.0.1:8199/history.yaml#History",
+			wantHistory: true,
+			wantTag:     "History",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.wantTag, func(t *testing.T) {
+			latest, history, tag := identifyLocalSubType(test.url, listenPort, storePort)
+			if latest != test.wantLatest || history != test.wantHistory || tag != test.wantTag {
+				t.Fatalf("identifyLocalSubType() = (%v, %v, %q), want (%v, %v, %q)",
+					latest, history, tag, test.wantLatest, test.wantHistory, test.wantTag)
+			}
+		})
+	}
+}
